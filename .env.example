# Copie ce fichier en .env (pour Docker Compose ou `node server.js`)
# ou recopie ces variables dans la stack Portainer (section « Environment variables »).

# Mot de passe pour modifier le dashboard depuis la page (bouton crayon).
# Vide = dashboard en lecture seule.
ADMIN_PASSWORD=

# Clé API PandaScore pour les sections e-sport (gratuite sur https://app.pandascore.co).
# Vide = les sections e-sport affichent un message à la place des matchs.
PANDASCORE_TOKEN=

# Port d'écoute (facultatif, 3010 par défaut)
# PORT=3010
