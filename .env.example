# Tout est FACULTATIF : le mot de passe admin et la clé PandaScore se règlent aussi
# directement dans la page (Réglages → Clés & accès).
# Une variable définie ici a la priorité sur la page, et n'y est alors plus modifiable.
#
# Copie ce fichier en .env (Docker Compose ou `node server.js`),
# ou recopie les variables dans la stack Portainer (« Environment variables »).

# Mot de passe du mode édition. Vide : il est créé au premier clic sur le crayon.
ADMIN_PASSWORD=

# Clé API PandaScore pour l'e-sport (gratuite sur https://app.pandascore.co).
PANDASCORE_TOKEN=

# Port de ton serveur sur lequel Kiosque est accessible avec Docker (3010 par défaut)
# KIOSQUE_PORT=3000

# Comparateur de prix : relais de lecture utilisé quand Idealo, LeDénicheur ou une boutique
# bloquent ton serveur (https://r.jina.ai/ par défaut, gratuit). « off » pour le désactiver.
# PRICES_RELAY=off
# Clé Jina facultative pour dépasser ~20 pages par minute via le relais.
# JINA_API_KEY=
